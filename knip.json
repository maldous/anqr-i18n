{
  "$schema": "https://unpkg.com/knip@1.31.0/schema.json",
  "entry": ["src/main.js"],
  "project": ["src/**/*.{js,ts,mjs,cjs}"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/reports/**",
    "**/releases/**",
    "**/.netlify/**",
    "**/.scannerwork/**",
    "**/.sonar/**",
    "public/**"
  ],
  "ignoreDependencies": [
    "@microsoft/api-extractor",
    "cloc",
    "danger",
    "depcheck",
    "jsdoc",
    "license-checker",
    "madge",
    "plato",
    "retire",
    "snyk",
    "sonarqube-scanner",
    "source-map-explorer",
    "ts-prune",
    "typedoc",
    "unimported"
  ],
  "ignoreBinaries": ["shfmt"]
}
