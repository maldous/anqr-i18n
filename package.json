{
  "name": "anqr",
  "version": "1.0.0",
  "description": "Professional animated QR code generator with image and GIF overlay support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,mjs,cjs}\"",
    "clean": "rm -rf dist node_modules",
    "serve": "vite preview --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "keywords": [
    "qr-code",
    "animated-qr",
    "gif",
    "image-overlay",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
