{
  "name": "anqr",
  "version": "1.0.0",
  "description": "Professional animated QR code generator with image and GIF overlay support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,mjs,cjs}\"",
    "clean": "rm -rf dist node_modules",
    "serve": "vite preview --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report": "bash scripts/report/run.sh",
    "build:analyze": "ANALYZE=1 vite build"
  },
  "keywords": [
    "qr-code",
    "animated-qr",
    "gif",
    "image-overlay",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@microsoft/api-extractor": "^7.47.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cloc": "^2.10.0",
    "danger": "^13.0.5",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-unsanitized": "^4.0.0",
    "eslint-plugin-redos": "^4.0.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-security-node": "^1.1.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "globals": "^16.5.0",
    "jsdoc": "^4.0.3",
    "knip": "^5.0.0",
    "license-checker": "^25.0.1",
    "madge": "^6.1.0",
    "plato": "^1.7.0",
    "prettier": "^3.4.2",
    "retire": "^5.2.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "snyk": "^1.1290.0",
    "sonarqube-scanner": "^4.2.8",
    "source-map-explorer": "^2.5.3",
    "terser": "^5.31.0",
    "ts-prune": "^0.10.3",
    "typedoc": "^0.28.15",
    "typescript": "^5.5.0",
    "unimported": "^1.31.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "qr": "^0.5.1"
  },
  "engines": {
    "node": ">=18"
  }
}
